<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Belediye Talep Sistemi</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BelediyeTalepSistemi.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header>
        <div class="top-info-bar">
            <div class="container d-flex justify-content-between align-items-center">
                <span>Belediye Talep ve Şikâyet Yönetim Sistemi</span>

                <div class="d-none d-md-flex gap-3">
                    
                    <span>✉ belediyetalepdemo@gmail.com</span>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg main-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/adana-logo.png"
                         alt="Belediye Logosu"
                         class="navbar-logo" />

                    <div class="brand-text">
                        <strong>Belediye Talep Sistemi</strong>
                        <small>Talep ve Şikayet Yönetimi</small>
                    </div>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Menüyü Aç">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>

                        @if (Context.Session.GetString("Rol") == "Vatandas")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Talep" asp-action="Create">Talep Oluştur</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Talep" asp-action="Index">Taleplerim</a>
                            </li>
                        }

                        @if (Context.Session.GetString("Rol") == "Personel")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Personel" asp-action="Index">Personel Paneli</a>
                            </li>
                        }

                        @if (Context.Session.GetString("Rol") == "Yonetici")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Yonetici" asp-action="Index">Yönetici Paneli</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Yonetici" asp-action="Dashboard">Dashboard</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Mudurluk" asp-action="Index">Müdürlükler</a>
                            </li>
                        }

                        @if (Context.Session.GetString("AdSoyad") != null)
                        {
                            <li class="nav-item ms-lg-3">
                                <span class="nav-link user-welcome">
                                    Merhaba, @Context.Session.GetString("AdSoyad")
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">
                                    Çıkış Yap
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                                    Giriş Yap
                                </a>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-orange btn-sm" asp-controller="Account" asp-action="Register">
                                    Kayıt Ol
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="page-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <span>&copy; 2026 - Belediye Talep Sistemi</span>
            <span>Talep, şikâyet ve belediye hizmetleri takip sistemi</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>