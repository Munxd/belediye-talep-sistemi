@{
    ViewData["Title"] = "Ana Sayfa";

    var adSoyad = Context.Session.GetString("AdSoyad");
    var rol = Context.Session.GetString("Rol");
}

<section class="home-hero">
    <div class="container">
        <div class="home-hero-content text-center">
            <img src="~/images/adana-logo.png"
                 alt="Belediye Logosu"
                 class="home-hero-logo" />

            <h1>Belediye Talep ve Şikayet Sistemi</h1>

            @if (adSoyad == null)
            {
                <p>
                    Merhaba, belediye hizmetleriyle ilgili talep ve şikayetlerinizi sisteme giriş yaparak kolayca oluşturabilirsiniz.
                </p>

                <div class="hero-search-box">
                    <span>Size nasıl yardımcı olabiliriz?</span>
                    <a asp-controller="Account" asp-action="Login" class="hero-search-button">
                        Giriş
                    </a>
                </div>

                <div class="hero-action-buttons">
                    <a asp-controller="Account" asp-action="Login" class="hero-pill">
                        Giriş Yap
                    </a>

                    <a asp-controller="Account" asp-action="Register" class="hero-pill">
                        Kayıt Ol
                    </a>

                    <a href="#sistemBilgileri" class="hero-pill">
                        Sistem Hakkında
                    </a>
                </div>
            }
            else if (rol == "Vatandas")
            {
                <p>
                    Merhaba @adSoyad, talep ve şikâyet işlemlerinizi aşağıdaki alanlardan yönetebilirsiniz.
                </p>

                <div class="hero-search-box">
                    <span>Yeni bir talep oluşturabilir veya mevcut taleplerinizi takip edebilirsiniz.</span>
                    <a asp-controller="Talep" asp-action="Create" class="hero-search-button">
                        Talep Oluştur
                    </a>
                </div>

                <div class="hero-action-buttons">
                    <a asp-controller="Talep" asp-action="Create" class="hero-pill">
                        Talep Oluştur
                    </a>

                    <a asp-controller="Talep" asp-action="Index" class="hero-pill">
                        Taleplerim
                    </a>
                </div>
            }
            else if (rol == "Personel")
            {
                <p>
                    Merhaba @adSoyad, bağlı olduğunuz müdürlüğe gelen aktif talepleri personel panelinden inceleyebilirsiniz.
                </p>

                <div class="hero-search-box">
                    <span>Size atanmış birim taleplerini görüntülemek için personel paneline geçebilirsiniz.</span>
                    <a asp-controller="Personel" asp-action="Index" class="hero-search-button">
                        Panele Git
                    </a>
                </div>

                <div class="hero-action-buttons">
                    <a asp-controller="Personel" asp-action="Index" class="hero-pill">
                        Personel Paneli
                    </a>
                </div>
            }
            else if (rol == "Yonetici")
            {
                <p>
                    Merhaba @adSoyad, sistemdeki talepleri, müdürlükleri ve raporları yönetebilirsiniz.
                </p>

                <div class="hero-search-box">
                    <span>Talep durumlarını, dashboard ekranını ve müdürlük yönetimini buradan takip edebilirsiniz.</span>
                    <a asp-controller="Yonetici" asp-action="Dashboard" class="hero-search-button">
                        Dashboard
                    </a>
                </div>

                <div class="hero-action-buttons">
                    <a asp-controller="Yonetici" asp-action="Index" class="hero-pill">
                        Yönetici Paneli
                    </a>

                    <a asp-controller="Yonetici" asp-action="Dashboard" class="hero-pill">
                        Dashboard
                    </a>

                    <a asp-controller="Mudurluk" asp-action="Index" class="hero-pill">
                        Müdürlükler
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<section class="container home-info-section" id="sistemBilgileri">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="home-info-card">
                <div class="info-card-icon">📝</div>
                <h4>Talep Oluşturma</h4>
                <p>
                    Vatandaşlar talep veya şikâyetlerini açıklama, adres, konum ve fotoğraf bilgisiyle sisteme kaydedebilir.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="home-info-card">
                <div class="info-card-icon">📍</div>
                <h4>Konum Takibi</h4>
                <p>
                    Konum bilgisi olan talepler harita üzerinde görüntülenir ve ilgili müdürlükler tarafından takip edilir.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="home-info-card">
                <div class="info-card-icon">📊</div>
                <h4>Yönetim Paneli</h4>
                <p>
                    Yönetici ekranında talepler, müdürlük dağılımları, durum bilgileri ve harita üzerinden raporlar incelenebilir.
                </p>
            </div>
        </div>
    </div>
</section>