@model List<BelediyeTalepSistemi.Models.Talep>

@functions {
    string OncelikBadgeClass(string? oncelik)
    {
        return oncelik switch
        {
            "Yüksek" => "bg-danger",
            "Orta" => "bg-warning text-dark",
            "Düşük" => "bg-success",
            _ => "bg-secondary"
        };
    }

    string DurumBadgeClass(string? durum)
    {
        return durum switch
        {
            "Yeni" => "bg-primary",
            "İnceleniyor" => "bg-warning text-dark",
            "Tamamlandı" => "bg-success",
            "İptal Edildi" => "bg-secondary",
            _ => "bg-info text-dark"
        };
    }
}

@{
    ViewData["Title"] = "Taleplerim";

    var toplamTalep = Model.Count;
    var yeniTalep = Model.Count(t => t.TalepDurumu?.DurumAdi == "Yeni");
    var inceleniyorTalep = Model.Count(t => t.TalepDurumu?.DurumAdi == "İnceleniyor");
    var tamamlananTalep = Model.Count(t => t.TalepDurumu?.DurumAdi == "Tamamlandı");
}

<section class="panel-page-section">
    <div class="container">

        <div class="panel-page-header">
            <div>
                <span class="panel-page-label">Vatandaş Paneli</span>
                <h2>Taleplerim</h2>
                <p>Oluşturduğunuz talep ve şikâyetleri buradan takip edebilirsiniz.</p>
            </div>

            <a asp-controller="Talep" asp-action="Create" class="btn btn-orange">
                Yeni Talep Oluştur
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success shadow-sm">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="summary-card">
                    <span>Toplam Talep</span>
                    <strong>@toplamTalep</strong>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="summary-card">
                    <span>Yeni</span>
                    <strong>@yeniTalep</strong>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="summary-card">
                    <span>İnceleniyor</span>
                    <strong>@inceleniyorTalep</strong>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="summary-card">
                    <span>Tamamlandı</span>
                    <strong>@tamamlananTalep</strong>
                </div>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-state-card">
                <h4>Henüz talebiniz bulunmuyor.</h4>
                <p>Belediye hizmetleriyle ilgili yeni bir talep veya şikâyet oluşturabilirsiniz.</p>

                <a asp-controller="Talep" asp-action="Create" class="btn btn-orange">
                    İlk Talebimi Oluştur
                </a>
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="table-card-header">
                    <h5>Talep Listesi</h5>
                    <span>@Model.Count kayıt görüntüleniyor</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle modern-table">
                        <thead>
                            <tr>
                                <th>Başlık</th>
                                <th>Kategori</th>
                                <th>Müdürlük</th>
                                <th>Durum</th>
                                <th>Öncelik</th>
                                <th>Tarih</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var talep in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@talep.Baslik</strong>
                                    </td>

                                    <td>@talep.Kategori</td>

                                    <td>
                                        @(talep.Mudurluk?.MudurlukAdi ?? "Belirtilmedi")
                                    </td>

                                    <td>
                                        <span class="badge @DurumBadgeClass(talep.TalepDurumu?.DurumAdi)">
                                            @(talep.TalepDurumu?.DurumAdi ?? "Bilinmiyor")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge @OncelikBadgeClass(talep.OncelikSeviyesi)">
                                            @(talep.OncelikSeviyesi ?? "Orta")
                                        </span>
                                    </td>

                                    <td>
                                        @talep.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")
                                    </td>

                                    <td>
                                        <div class="table-action-buttons">
                                            <a asp-controller="Talep"
                                               asp-action="Details"
                                               asp-route-id="@talep.Id"
                                               class="btn btn-sm btn-info">
                                                Detay
                                            </a>

                                            <a asp-controller="Talep"
                                               asp-action="Edit"
                                               asp-route-id="@talep.Id"
                                               class="btn btn-sm btn-warning">
                                                Düzenle
                                            </a>

                                            <a asp-controller="Talep"
                                               asp-action="Delete"
                                               asp-route-id="@talep.Id"
                                               class="btn btn-sm btn-danger">
                                                Sil
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>