@model List<BelediyeTalepSistemi.Models.Talep>

@functions {
    string OncelikBadgeClass(string? oncelik)
    {
        return oncelik switch
        {
            "Yüksek" => "bg-danger",
            "Orta" => "bg-warning text-dark",
            "Düşük" => "bg-success",
            _ => "bg-secondary"
        };
    }
}


@{
    ViewData["Title"] = "Taleplerim";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Taleplerim</h2>
        <a asp-controller="Talep" asp-action="Create" class="btn btn-primary">Yeni Talep Oluştur</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Henüz oluşturulmuş bir talebiniz bulunmamaktadır.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th>Kategori</th>
                    <th>Müdürlük</th>
                    <th>Durum</th>
                    <th>Öncelik</th>
                    <th>Tarih</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var talep in Model)
                {
                    <tr>
                        <td>@talep.Baslik</td>
                        <td>@talep.Kategori</td>
                        <td>@talep.Mudurluk?.MudurlukAdi</td>
                        <td>@talep.TalepDurumu?.DurumAdi</td>
                        <td>
                            <span class="badge @OncelikBadgeClass(talep.OncelikSeviyesi)">
                                @(talep.OncelikSeviyesi ?? "Orta")
                            </span>
                        </td>
                        <td>@talep.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <a asp-controller="Talep" asp-action="Details" asp-route-id="@talep.Id" class="btn btn-sm btn-info">
                                Detay
                            </a>

                            <a asp-controller="Talep" asp-action="Edit" asp-route-id="@talep.Id" class="btn btn-sm btn-warning">
                                Düzenle
                            </a>

                            <a asp-controller="Talep" asp-action="Delete" asp-route-id="@talep.Id" class="btn btn-sm btn-danger">
                                Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>