@model BelediyeTalepSistemi.Models.Talep
@using System.Globalization
@using System.Text.Json

@{
    ViewData["Title"] = "Talep Detayı";

    var enlem = Model.Enlem?.ToString(CultureInfo.InvariantCulture);
    var boylam = Model.Boylam?.ToString(CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

    <style>
        #personelMap {
            height: 350px;
            width: 100%;
            border-radius: 8px;
            border: 1px solid #ddd;
        }
    </style>
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header">
            <h3>Personel Talep Detayı</h3>
        </div>

        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <dl class="row">
                <dt class="col-sm-3">Vatandaş</dt>
                <dd class="col-sm-9">@Model.ApplicationUser?.AdSoyad</dd>

                <dt class="col-sm-3">Başlık</dt>
                <dd class="col-sm-9">@Model.Baslik</dd>

                <dt class="col-sm-3">Açıklama</dt>
                <dd class="col-sm-9">@Model.Aciklama</dd>

                <dt class="col-sm-3">Kategori</dt>
                <dd class="col-sm-9">@Model.Kategori</dd>

                <dt class="col-sm-3">Müdürlük</dt>
                <dd class="col-sm-9">@Model.Mudurluk?.MudurlukAdi</dd>

                <dt class="col-sm-3">Mevcut Durum</dt>
                <dd class="col-sm-9">@Model.TalepDurumu?.DurumAdi</dd>

                <dt class="col-sm-3">Öncelik</dt>
                <dd class="col-sm-9">@Model.OncelikSeviyesi</dd>

                <dt class="col-sm-3">Açık Adres</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.AcikAdres))
                    {
                        @Model.AcikAdres
                    }
                    else
                    {
                        <span class="text-muted">Adres bilgisi girilmemiş.</span>
                    }
                </dd>

                <dt class="col-sm-3">Konum</dt>
                <dd class="col-sm-9">
                    @if (Model.Enlem != null && Model.Boylam != null)
                    {
                        <span>Enlem: @Model.Enlem</span>
                        <br />
                        <span>Boylam: @Model.Boylam</span>
                    }
                    else
                    {
                        <span class="text-muted">Konum bilgisi bulunmuyor.</span>
                    }
                </dd>

                <dt class="col-sm-3">Oluşturulma Tarihi</dt>
                <dd class="col-sm-9">@Model.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>

            @if (!string.IsNullOrEmpty(Model.FotografYolu))
            {
                <hr />

                <h5>Eklenen Fotoğraf</h5>

                <img src="@Model.FotografYolu"
                     class="img-fluid rounded shadow-sm"
                     style="max-width: 400px;"
                     alt="Talep fotoğrafı" />
            }

            @if (Model.Enlem != null && Model.Boylam != null)
            {
                <hr />

                <h5>Talep Konumu</h5>
                <div id="personelMap"></div>
            }

            <hr />

            <h5>Durum Güncelle</h5>

            <form asp-controller="Personel" asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                <div class="mb-3">
                    <label class="form-label">Yeni Durum</label>
                    <select name="talepDurumuId" class="form-control" asp-items="ViewBag.Durumlar">
                        <option value="">Durum seçiniz</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-warning">Durumu Güncelle</button>
                <a asp-controller="Personel" asp-action="Index" class="btn btn-secondary">Panele Dön</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Enlem != null && Model.Boylam != null)
    {
        <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

        <script>
            var enlem = parseFloat("@enlem");
            var boylam = parseFloat("@boylam");

            var baslik = @Html.Raw(JsonSerializer.Serialize(Model.Baslik));
            var adres = @Html.Raw(JsonSerializer.Serialize(Model.AcikAdres));

            var map = L.map('personelMap').setView([enlem, boylam], 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
            }).addTo(map);

            L.circleMarker([enlem, boylam], {
            radius: 9,
            color: 'red',
            fillColor: 'red',
            fillOpacity: 0.8
            }).addTo(map)
            .bindPopup("<b>" + baslik + "</b><br/>" + adres)
            .openPopup();
        </script>
    }
}